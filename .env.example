# =============================================================================
# Totalmobi Booking — variáveis de ambiente
#
# ⚠️ O destino é `apps/web/.env.local`, NÃO a raiz do monorepo.
#
#     npm run setup:env
#
# O Next.js só lê ficheiros `.env` a partir da pasta da própria app. Um
# `.env.local` na raiz é ignorado em silêncio — a app arranca, não dá erro
# nenhum, e comporta-se como se não houvesse configuração. Custou tempo uma vez;
# é o que o `setup:env` existe para evitar.
#
# NUNCA cometer valores reais. Este ficheiro é o catálogo, não a configuração.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Domínio onde as páginas públicas de marcação são servidas.
NEXT_PUBLIC_BOOKING_DOMAIN=localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Supabase
# Projeto partilhado com o Totalmobi CMS — schema `booking`.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ SÓ NO SERVIDOR. Contorna a RLS por completo.
# Se esta chave chegar ao browser, qualquer pessoa lê os dados de todos os
# tenants. Só pode ser importada em módulos com `import 'server-only'`.
SUPABASE_SERVICE_ROLE_KEY=

# Ligação direta ao Postgres, para migrations e testes locais.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# -----------------------------------------------------------------------------
# Cifra de tokens de integração (Milestone 13)
# 32 bytes em base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# -----------------------------------------------------------------------------
# (o WhatsApp usa WHATSAPP_TOKEN_KEY; esta fica para outras integrações)
#ENCRYPTION_KEY=
#ENCRYPTION_KEY_ID=v1

# -----------------------------------------------------------------------------
# Meta WhatsApp Business Platform (Milestone 13)
# -----------------------------------------------------------------------------
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_SYSTEM_USER_TOKEN=
# (substituído por WHATSAPP_VERIFY_TOKEN, mais abaixo)
#WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_CONFIG_ID=

# -----------------------------------------------------------------------------
# Email (Milestone 12)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=resend
#RESEND_API_KEY=  (ver a secção Notificações)
# (substituído por EMAIL_FROM, mais abaixo)
#EMAIL_FROM_ADDRESS=nao-responder@totalmobi.pt
EMAIL_FROM_NAME=Totalmobi Booking

# -----------------------------------------------------------------------------
# IA (Milestone 14)
# -----------------------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modelo pequeno para extração de intenção; escalar só quando necessário.
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_SMART=claude-sonnet-5

# -----------------------------------------------------------------------------
# Voz (Milestone 24 — MVP 3)
# -----------------------------------------------------------------------------
VOICE_PROVIDER=
VOICE_STT_API_KEY=
VOICE_TTS_API_KEY=

# -----------------------------------------------------------------------------
# Pagamentos (MVP 2)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Observabilidade
# -----------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info

# --- Notificações -------------------------------------------------------------
# Segredo que protege /api/notificacoes/tick. Sem ele a rota devolve 503.
NOTIFICATIONS_CRON_SECRET=
# O remetente. Tem de ser de um domínio verificado no fornecedor escolhido.
EMAIL_FROM=
# Brevo é o primeiro a ser tentado: o totalmobi.pt já lá está verificado.
BREVO_API_KEY=
# Resend, alternativa. Precisa de um TXT em resend._domainkey — que o painel do
# one.com recusa. Ver docs/DEPLOY.md.
RESEND_API_KEY=
# Força a escolha quando ambas as chaves existirem: "brevo" ou "resend".
EMAIL_PROVIDER=

# --- WhatsApp (Meta Cloud API) ------------------------------------------------
# App Secret da aplicação Meta: valida a assinatura dos webhooks.
WHATSAPP_APP_SECRET=
# Token que a Meta envia no desafio de verificação do webhook.
WHATSAPP_VERIFY_TOKEN=
# Chave de cifra dos tokens de acesso dos clientes: openssl rand -base64 32
WHATSAPP_TOKEN_KEY=
WHATSAPP_TOKEN_KEY_ID=k1

# --- Stripe ------------------------------------------------------------------
# Os price_id NÃO são segredos: podem estar aqui e no repositório. O que é
# segredo é a chave secreta e o segredo de assinatura do webhook, e esses só
# existem no ambiente — nunca neste ficheiro.
#
# Os identificadores abaixo são do MODO DE TESTE. O modo real tem outros; a
# troca faz-se no ambiente, não no código.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

STRIPE_PRICE_ESSENTIAL_MONTHLY=price_1U8RLdGZqwyVcDAEVmScdaJG
STRIPE_PRICE_ESSENTIAL_ANNUAL=price_1U8RNQGZqwyVcDAEPC3BSv4d
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_1U8ROoGZqwyVcDAEg3v6coQw
STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_1U8RQ7GZqwyVcDAEWX6CvjNK
STRIPE_PRICE_AI_MONTHLY=price_1U8RR6GZqwyVcDAE8192Hv5a
STRIPE_PRICE_AI_ANNUAL=price_1U8RS0GZqwyVcDAEyiaEm0Nn
